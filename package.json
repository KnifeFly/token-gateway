{
  "name": "token-gateway",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "api:check": "pnpm generate:api && git diff --exit-code -- web/packages/api-client/src/generated",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "generate:api": "pnpm --filter @token-gateway/api-client generate",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.0.0"
  }
}
